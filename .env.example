# Copy to .env and fill in.
CHANNEL_NAME=мой канал
CHANNEL_URL=https://t.me/my_channel
# A bot (from @BotFather) added to the channel as an admin with "Post messages".
BOT_TOKEN=123456:ABC...
CHANNEL_ID=@my_channel
# Or post as the host's telegram-mcp default account (needs CHANNEL_ID, no BOT_TOKEN):
# CHANNEL_MCP=1
# Optional:
# CUSTOM_EMOJI=0             # premium emoji; on by default without a bot
# MODEL=claude-sonnet-5-5
# FOOTER=🐾 <a href="https://t.me/my_channel"><b>мой канал</b></a>
# NODE=/usr/bin/node
